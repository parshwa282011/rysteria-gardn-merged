# Settings for the phone scripts (scripts-phones/). Copy of phones.env.example is phones.env (git-ignored).
# A script that needs an empty value stops and tells you which one. Lines marked #TODO: ADD THE INFO are yours to fill.
# Nothing secret belongs in THIS file: passwords are asked for when a script runs, keys stay in files outside the repo.

# --- what the apps open (the defaults are the live site) -------------------------------------------
GAME_URL=https://game.parshwa.blog/
API_HOST=api-game.parshwa.blog

# --- identity -----------------------------------------------------------------------------------------
# The id of the app in both stores. Once an app is published it can never change.
APP_ID=blog.parshwa.rysteria
# VERSION_NAME is what players see (1.0, 1.1 ...). VERSION_CODE is the build number the stores compare:
# it has to be HIGHER at every upload to Google Play and to App Store Connect (the iOS script remembers the last
# one it sent and refuses a repeat). Raise it by 1 before each release.
VERSION_NAME=1.0
VERSION_CODE=1

# --- Android signing (scripts-phones/android-deploy.sh) -------------------------------------------------
# The key that signs the app for Google Play. How to get it, once:
#   1. scripts-phones/make-keystore.sh        (asks for a password twice, makes the file below)
#   2. copy the .jks file to a safe second place; keep the password in a password manager
# Nothing more: ANDROID_KEYSTORE is where that file is, ANDROID_KEY_ALIAS the name inside it. The passwords are
# asked for when you build a release (or set ANDROID_KEYSTORE_PASSWORD / ANDROID_KEY_PASSWORD in your shell).
#TODO: ADD THE INFO (run scripts-phones/make-keystore.sh once; then this path is right)
ANDROID_KEYSTORE=~/.rysteria-phones/rysteria-upload.jks
ANDROID_KEY_ALIAS=rysteria

# --- iOS signing (scripts-phones/ios-build.sh device, ios-deploy.sh) ----------------------------------
# Your Apple Developer Team ID (developer.apple.com/account > Membership details > Team ID)
#TODO: ADD THE INFO (your Team ID, 10 characters)
IOS_TEAM_ID=

# --- App Store Connect API key: lets ios-deploy.sh --testflight / --production upload without typing your Apple password ---
# Get it once (about 5 minutes):
#   1. sign in at https://appstoreconnect.apple.com with the account that owns the team
#   2. Users and Access > Integrations > App Store Connect API > Team Keys (if it asks, click "Request Access" first)
#   3. "+" Generate API Key: Name "Rysteria deploy", Access "App Manager", Generate
#   4. Download API Key (the AuthKey_XXXXXXXXXX.p8 file): Apple lets you do this ONCE
#   5. mkdir -p ~/.rysteria-phones && mv ~/Downloads/AuthKey_XXXXXXXXXX.p8 ~/.rysteria-phones/ && chmod 600 ~/.rysteria-phones/AuthKey_*.p8
#   6. on that same page copy the KEY ID of the row (10 characters, the XXXXXXXXXX of the file name) and the
#      ISSUER ID (a UUID, shown above the table) into the three lines below
# Without the key you can still upload by hand: scripts-phones/ios-deploy.sh (builds the .ipa) and drag it into
# Apple's free "Transporter" app.
#TODO: ADD THE INFO (the Key ID of the API key, 10 characters)
ASC_KEY_ID=
#TODO: ADD THE INFO (the Issuer ID above the keys table, looks like 57246542-96fe-1a63-e053-0824d011072a)
ASC_ISSUER_ID=
#TODO: ADD THE INFO (the full path of the AuthKey .p8 file, e.g. ~/.rysteria-phones/AuthKey_XXXXXXXXXX.p8)
ASC_KEY_PATH=
