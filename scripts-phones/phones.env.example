# Settings for the phone scripts (scripts-phones/). Copy to phones.env (git-ignored) and fill in.
# An empty value that a script needs stops it and tells you which one.

# --- what the apps open (the defaults are the live site) -------------------------------------------
GAME_URL=https://game.parshwa.blog/
API_HOST=api-game.parshwa.blog

# --- identity -----------------------------------------------------------------------------------------
# The id of the app in the stores. Once an app is published it can never change.
APP_ID=blog.parshwa.rysteria
# Shown to players, and the number the stores compare: the code has to go UP with every upload
VERSION_NAME=1.0
VERSION_CODE=1

# --- Android signing (android-deploy.sh) ---------------------------------------------------------------
# A keystore made once with keytool, see README.md. Keep it OUTSIDE the repository and back it up:
# Google ties your app to it. The passwords are asked for when the script runs (or put
# ANDROID_KEYSTORE_PASSWORD / ANDROID_KEY_PASSWORD in the environment, never in this file).
ANDROID_KEYSTORE=~/.rysteria-phones/rysteria-upload.jks
ANDROID_KEY_ALIAS=rysteria

# --- iOS signing and upload (ios-build.sh device, ios-deploy.sh) -------------------------------------
# Your Apple Developer Team ID (10 characters): developer.apple.com > Membership details
IOS_TEAM_ID=
# For --upload only: an App Store Connect API key (appstoreconnect.apple.com > Users and Access >
# Integrations > App Store Connect API). The .p8 file stays outside the repository.
ASC_KEY_ID=
ASC_ISSUER_ID=
ASC_KEY_PATH=
