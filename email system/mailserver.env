# docker-mailserver settings. Full reference:
# https://docker-mailserver.github.io/docker-mailserver/latest/config/environment/

LOG_LEVEL=info
ONE_DIR=1
DMS_DEBUG=0

# TLS: certificates come from Let's Encrypt (see ./manage.sh cert)
SSL_TYPE=letsencrypt

# Spam filtering, plus DKIM signing and SPF/DKIM/DMARC checks, are all done by Rspamd
ENABLE_RSPAMD=1
ENABLE_OPENDKIM=0
ENABLE_OPENDMARC=0
ENABLE_POLICYD_SPF=0
ENABLE_AMAVIS=0
ENABLE_SPAMASSASSIN=0
ENABLE_POSTGREY=0
# ClamAV needs about 1 GB of RAM; turn on if you have it
ENABLE_CLAMAV=0

# Block repeated failed logins
ENABLE_FAIL2BAN=1

# IMAP only; no POP3
ENABLE_POP3=0
ENABLE_IMAP=1

# Reject mail that claims to be from your domain unless the sender is logged in as that user
SPOOF_PROTECTION=1

# Never act as an open relay
PERMIT_DOCKER=none

# 50 MB message size limit
POSTFIX_MESSAGE_SIZE_LIMIT=52428800

# Deliver spam to the Junk folder instead of dropping it
MOVE_SPAM_TO_JUNK=1
