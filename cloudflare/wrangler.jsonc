{
  // The website of both games as a Cloudflare Worker: the static files that scripts/build-web.sh
  // puts in ./dist, and a few lines of Worker (worker.js) for the gardn websocket.
  // The master, the game servers and gardn itself stay on your machines behind the cloudflared tunnel.
  "name": "rysteria-web",
  "main": "worker.js",
  "compatibility_date": "2026-11-01",
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // /login serves login.html, /gardn/ serves gardn/index.html, ...
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    // only these go through worker.js first (the gardn page and its websocket share a path); every
    // other file is answered by the static assets without running any Worker code
    "run_worker_first": ["/gardn", "/gardn/", "/health"]
  },
  "vars": {
    // a hostname of the tunnel that leads to the edge of a machine (scripts/common/edge.js): where
    // the gardn websocket is sent. It must not be the hostname of this Worker.
    "ORIGIN_HOST": "origin-game.parshwa.blog"
  }
  // To serve the site on your own hostname instead of rysteria-web.<you>.workers.dev (see cloudflare/README.md first):
  // "routes": [{ "pattern": "game.parshwa.blog", "custom_domain": true }]
}
